# Copie para .env e preencha. Nunca versione o .env.
ENV=prod                      # dev | test | prod
LOG_LEVEL=INFO                # nível dos logs (structlog)

# Banco (no compose a URL é montada a partir destes três)
POSTGRES_USER=learn
# Gere com: openssl rand -hex 32 (sem / nem +, que quebram a DATABASE_URL)
POSTGRES_PASSWORD=troque-por-uma-senha-longa
POSTGRES_DB=learnwatching
# Só para rodar fora do compose (ex.: make dev com o compose.dev.yml):
# DATABASE_URL=postgresql+psycopg://learn:learn@127.0.0.1:5433/learnwatching

# Origens do app que podem chamar a API, separadas por vírgula (em dev o padrão é http://localhost:5200)
CORS_ORIGINS=https://exemplo.com.br
# Endereço público da API
PUBLIC_API_URL=https://api.exemplo.com.br

# Domínios na borda (Caddy compartilhado com o core-studio; o certificado sai sozinho)
LEARN_DOMAIN=api.exemplo.com.br
LEARN_APP_DOMAIN=exemplo.com.br

# Imagem no ar: gravada pelo deploy.sh na VPS (não preencha à mão)
# API_IMAGE=learnwatching-api:<sha>
