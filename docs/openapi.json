{
  "openapi": "3.1.0",
  "info": {
    "title": "LearnWatching API",
    "description": "Lista as legendas disponíveis de vídeos do YouTube para o LearnWatching.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Estamos Online",
        "operationId": "estamos_online_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Ready",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/subtitles/list": {
      "get": {
        "tags": [
          "subtitles"
        ],
        "summary": "List Subtitles",
        "description": "Lista todas as legendas disponíveis para um vídeo do YouTube.",
        "operationId": "list_subtitles_api_subtitles_list_get",
        "parameters": [
          {
            "name": "video_url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Video Url"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubtitleListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "SubtitleInfo": {
        "properties": {
          "language_code": {
            "type": "string",
            "title": "Language Code"
          },
          "language_name": {
            "type": "string",
            "title": "Language Name"
          },
          "is_auto_generated": {
            "type": "boolean",
            "title": "Is Auto Generated"
          }
        },
        "type": "object",
        "required": [
          "language_code",
          "language_name",
          "is_auto_generated"
        ],
        "title": "SubtitleInfo",
        "description": "Informações sobre uma legenda disponível."
      },
      "SubtitleListResponse": {
        "properties": {
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "video_title": {
            "type": "string",
            "title": "Video Title"
          },
          "subtitles": {
            "items": {
              "$ref": "#/components/schemas/SubtitleInfo"
            },
            "type": "array",
            "title": "Subtitles"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "video_title",
          "subtitles"
        ],
        "title": "SubtitleListResponse",
        "description": "Resposta com lista de legendas disponíveis."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
